      m_Calls: []
  m_text: "<b>Aviso</b>\nEl modo inmersivo puede mostrar movimientos simulados (rebotes,
    giros, deslizamientos) y cambios de escala o perspectiva. Algunas personas podr\xEDan
    marearse."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 11f64a2015caf044384c81261e13389a, type: 2}
